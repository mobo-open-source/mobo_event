<?xml version="1.0" encoding="utf-8"?>
<!--
  Used for Android API 31+ (see: https://developer.android.com/about/versions/12/backup-restore).
  Excludes the Flutter SharedPreferences file so saved server URL / login history does not
  survive an uninstall+reinstall via cloud backup or device-to-device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml" />
    </device-transfer>
</data-extraction-rules>
